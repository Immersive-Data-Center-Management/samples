+void ARCoreInterface::qr_scanner_start() {
+	ALOGV("Godot ARCore: qr_scanner_start() called");
+	if (!m_qr_scanner.is_scanning()) {
+		// Lazy-initialize the JNI bridge — use current-thread env (GL thread)
+		JNIEnv *env = ARCoreWrapper::get_env_for_current_thread();
+		jobject activity = ARCoreWrapper::get_activity();
+		ALOGV("Godot ARCore: get_env_for_current_thread()=%p, get_activity()=%p", env, activity);
+		if (env && activity) {
+			ALOGV("Godot ARCore: Calling m_qr_scanner.initialize()");
+			m_qr_scanner.initialize(env, activity);
+		} else {
+			ALOGE("Godot ARCore: qr_scanner_start failed - env=%p, activity=%p", env, activity);
+		}
+	}
+	ALOGV("Godot ARCore: Calling m_qr_scanner.start()");
+	m_qr_scanner.start();
+	ALOGV("Godot ARCore: After start, is_scanning=%d", m_qr_scanner.is_scanning());
