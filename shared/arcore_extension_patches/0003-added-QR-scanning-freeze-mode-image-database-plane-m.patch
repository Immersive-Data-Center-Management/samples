+void ARCoreInterface::set_ar_session_state(int p_state) {
+	ARSessionState new_state = static_cast<ARSessionState>(p_state);
+	if (new_state == m_session_state) {
+		return;
+	}
+
+	ARSessionState old_state = m_session_state;
+	m_session_state = new_state;
+
+	if (m_ar_session != nullptr) {
+		bool was_fully_paused = (old_state == AR_SESSION_FULLY_PAUSED);
+		bool is_fully_paused = (new_state == AR_SESSION_FULLY_PAUSED);
+
+		// Only stop/start the camera on actual transitions into/out of FULLY_PAUSED.
+		// FROZEN keeps the session running, so resuming from it is seamless.
+		if (!was_fully_paused && is_fully_paused) {
+			ArSession_pause(m_ar_session);
+		} else if (was_fully_paused && !is_fully_paused) {
+			ArSession_resume(m_ar_session);
+		}
+	}
+}
+
+int ARCoreInterface::get_ar_session_state() const {
+	return static_cast<int>(m_session_state);
+}
