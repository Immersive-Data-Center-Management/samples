+double ARCoreInterface::get_camera_fov() const {
+	// For a perspective projection the vertical focal term is columns[1][1] == 1/tan(fovY/2),
+	// so fovY = 2*atan(1/columns[1][1]). Return degrees; 0 signals "not ready / invalid" so the
+	// caller can ignore it (m_projection starts as a valid 60 deg perspective, so this is defensive).
+	double focal_y = (double)m_projection.columns[1][1];
+	if (focal_y <= 0.0) {
+		return 0.0;
+	}
+	return Math::rad_to_deg(2.0 * Math::atan(1.0 / focal_y));
+}
+
+PackedFloat64Array ARCoreInterface::get_projection_matrix() const {
+	PackedFloat64Array arr;
+	arr.resize(16); // 4x4, column-major (same layout as _get_projection_for_view)
+	const real_t *p = (const real_t *)&m_projection.columns;
+	for (int i = 0; i < 16; i++) {
+		arr[i] = p[i];
+	}
+	return arr;
+}
