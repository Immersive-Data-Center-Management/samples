[node name="HeadLight" type="DirectionalLight3D" parent="Margin/VBox/ViewerContainer/Viewer/Camera"]

[node name="UsdStageNode3D" type="UsdStageNode3D" parent="Margin/VBox/ViewerContainer/Viewer"]

[node name="StageSelection" type="Node" parent="Margin/VBox/ViewerContainer/Viewer" node_paths=PackedStringArray("stage")]
