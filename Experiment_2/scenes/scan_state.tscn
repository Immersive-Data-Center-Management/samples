[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/scan_state.gd" id="1_s"]
[ext_resource type="Script" path="res://addons/sample_framework_ar/QRCodeTrackedComponent.gd" id="2_qr"]

[node name="Scan" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_s")
mouse_filter = 2

[node name="QRCodeTrackedComponent" type="Node" parent="."]
script = ExtResource("2_qr")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 72
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 0
mouse_filter = 2

[node name="HintLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = ""
horizontal_alignment = 1
autowrap_mode = 3
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="ResultLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = ""
horizontal_alignment = 1
autowrap_mode = 3
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8

[node name="DebugInput" type="LineEdit" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = ""
placeholder_text = "Desktop: QR content, Enter = scan"

[node name="BackButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Back to task"

